# ============================================================
# CLARA TRADEMARKS - Variables de Entorno
# ============================================================
# Copia este archivo como .env.local y llena los valores
# NUNCA subas .env.local a GitHub

# Neon PostgreSQL (obtenla en https://console.neon.tech → tu proyecto → Connection Details)
DATABASE_URL=postgresql://usuario:password@ep-xxx.us-east-1.aws.neon.tech/neondb?sslmode=require

# NextAuth — genera un string aleatorio fuerte:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=cambia_esto_por_un_string_aleatorio_muy_largo

# URL base de la app (en local es http://localhost:3000, en Vercel se pone automático)
NEXTAUTH_URL=http://localhost:3000

# Para Vercel: agrega estas variables en:
#   Settings → Environment Variables
